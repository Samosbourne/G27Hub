; Export list for the DirectInput effect driver COM server.
; Using a .def file (rather than __declspec(dllexport) on the COM entry points,
; which combaseapi.h has already declared) keeps the build warning-free and makes
; the DLL's export surface explicit: these two are all DirectInput needs.
LIBRARY g27ffb.dll
EXPORTS
    DllGetClassObject PRIVATE
    DllCanUnloadNow PRIVATE
