<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- só para o ícone da bandeja (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\G27Hub.Core\G27Hub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- g27ffb.dll (x64/ e x86/) e o plugin do ETS2/ATS (x64/), gerados por src/native/build.ps1 -->
    <None Include="..\native\out\**\g27ffb.dll;..\native\out\**\g27hub_telemetry.dll" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
