<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- VJoyFfb: COM da g27ffb.dll e estruturas do vJoy -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\G27Hub.Logging\G27Hub.Logging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- base de compatibilidade de jogos (Fase 6) -->
    <EmbeddedResource Include="..\..\data\compat-db.json" LogicalName="compat-db.json" />
    <!-- textos da interface em inglês (chave = português), ver Lang.cs -->
    <EmbeddedResource Include="..\..\data\lang-en.json" LogicalName="lang-en.json" />
    <!-- página do painel no celular (PhonePanel.cs) -->
    <EmbeddedResource Include="..\..\data\phone.html" LogicalName="phone.html" />
  </ItemGroup>

</Project>
